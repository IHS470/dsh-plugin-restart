{
  "name": "dsh-plugin-restart",
  "version": "2.0.1",
  "description": "Restart button for the DeepSeek Harness desktop app — the original v0.1.0 behaviour, plus the tool that puts a Restart item in the shell tray menu.",
  "type": "module",
  "license": "MIT",
  "author": "IHS470",
  "homepage": "https://github.com/IHS470/dsh-plugin-restart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHS470/dsh-plugin-restart.git"
  },
  "bugs": {
    "url": "https://github.com/IHS470/dsh-plugin-restart/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "restart",
    "relaunch",
    "desktop"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools",
    "docs"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs && node test/relaunch.test.mjs",
    "test:relaunch": "node test/relaunch.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
